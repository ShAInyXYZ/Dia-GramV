{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler",
    "strict": true, "allowJs": true, "checkJs": false, "skipLibCheck": true,
    "resolveJsonModule": true, "isolatedModules": true, "verbatimModuleSyntax": true, "noEmit": true
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "src/**/*.js"]
}
